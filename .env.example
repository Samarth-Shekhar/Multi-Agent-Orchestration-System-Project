# GitPilot environment configuration
# Copy to .env and fill in values. Never commit real API keys.

# LLM Provider: ollama | openai | mock
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible provider (when LLM_PROVIDER=openai)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub (optional for public repositories, required for private repositories)
GITHUB_TOKEN=

# Workflow
DRY_RUN=true
MAX_REPAIR_ATTEMPTS=3

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
WORKSPACE_DIR=workspaces
